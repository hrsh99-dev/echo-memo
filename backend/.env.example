# =============================================================================
# EchoMemo Backend Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Application
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas — Get a free cluster at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DATABASE=echomemo
VECTOR_SEARCH_INDEX=autoembed_index

# Auth — Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# ElevenLabs (optional — for premium TTS/STT)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Gemini — Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
EMBEDDING_MODEL=models/gemini-embedding-001
GENERATION_MODEL=models/gemini-3.8-flash

# Audio settings
AUDIO_RETENTION_ENABLED=false
AUDIO_MAX_BYTES=15728640
AUDIO_MAX_SECONDS=180

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_TRANSCRIBE=10/minute
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_SPEECH=10/minute
